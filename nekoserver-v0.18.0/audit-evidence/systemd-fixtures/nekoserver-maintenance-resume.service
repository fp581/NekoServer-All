[Unit]
Description=NekoServer recover interrupted monthly maintenance
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=6h
ExecStart=/workspace/scratch/1b7b3a1e8239/work/nekoserver-v0.18.0/runtime/bin/nekoserver-runtime maintenance-resume --config /etc/nekoserver-backups/config.json
[Install]
WantedBy=multi-user.target
