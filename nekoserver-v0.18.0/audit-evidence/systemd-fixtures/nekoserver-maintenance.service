[Unit]
Description=NekoServer monthly verified backup and container update
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
UMask=0077
Environment=TZ=Asia/Jerusalem
TimeoutStartSec=18h
TimeoutStopSec=6h
ExecStart=/workspace/scratch/1b7b3a1e8239/work/nekoserver-v0.18.0/runtime/bin/nekoserver-runtime maintenance --config /etc/nekoserver-backups/config.json
ExecStopPost=/workspace/scratch/1b7b3a1e8239/work/nekoserver-v0.18.0/runtime/bin/nekoserver-runtime maintenance-resume --config /etc/nekoserver-backups/config.json
