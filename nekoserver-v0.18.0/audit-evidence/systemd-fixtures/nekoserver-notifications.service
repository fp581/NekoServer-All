[Unit]
Description=NekoServer background health notifications
Wants=nekoserver-dashboard-collect.service
After=nekoserver-dashboard-collect.service network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=nekoserver-notifications
StateDirectoryMode=0700
RuntimeDirectory=nekoserver-notifications
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/workspace/scratch/1b7b3a1e8239/work/nekoserver-v0.18.0/runtime/bin/nekoserver-runtime notify --config /etc/nekoserver-backups/config.json --snapshot /run/nekoserver-dashboard/status.json --state /var/lib/nekoserver-notifications --runtime /run/nekoserver-notifications
TimeoutStartSec=45
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
