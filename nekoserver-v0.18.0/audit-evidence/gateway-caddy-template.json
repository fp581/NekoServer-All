{
  "admin": {
    "disabled": true
  },
  "apps": {
    "pki": {
      "certificate_authorities": {
        "local": {
          "install_trust": false
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": [
              "192.168.1.20"
            ],
            "issuers": [
              {
                "module": "internal",
                "ca": "local"
              }
            ]
          }
        ]
      }
    },
    "http": {
      "servers": {
        "portal": {
          "listen": [
            "192.168.1.20:8442"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "automatic_https": {
            "disable_redirects": true
          },
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "192.168.1.20"
                  ],
                  "remote_ip": {
                    "ranges": [
                      "192.168.1.0/24"
                    ]
                  },
                  "path": [
                    "/",
                    "/index.html"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "file_server",
                  "root": "/usr/local/share/nekoserver-gateway/lan",
                  "hide": [
                    ".*"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 403
                }
              ],
              "terminal": true
            }
          ]
        },
        "jellyfin": {
          "listen": [
            "192.168.1.20:8443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "automatic_https": {
            "disable_redirects": true
          },
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "192.168.1.20"
                  ],
                  "remote_ip": {
                    "ranges": [
                      "192.168.1.0/24"
                    ]
                  }
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:8096"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
