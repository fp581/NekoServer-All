[Unit]
Description=NekoServer host and user snapshot
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=2h
ExecStart=/workspace/scratch/1b7b3a1e8239/work/nekoserver-v0.18.0/runtime/bin/nekoserver-runtime host-snapshot --config /etc/nekoserver-backups/config.json
ExecStopPost=/workspace/scratch/1b7b3a1e8239/work/nekoserver-v0.18.0/runtime/bin/nekoserver-runtime host-resume --config /etc/nekoserver-backups/config.json
TimeoutStopSec=5min
