[Unit]
Description=NekoServer media application snapshot
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
After=docker.service
[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=2h
ExecStart=/workspace/scratch/1b7b3a1e8239/work/nekoserver-v0.18.0/runtime/bin/nekoserver-runtime app-snapshot --config /etc/nekoserver-backups/config.json
ExecStopPost=/workspace/scratch/1b7b3a1e8239/work/nekoserver-v0.18.0/runtime/bin/nekoserver-runtime app-resume --config /etc/nekoserver-backups/config.json
TimeoutStopSec=20min
