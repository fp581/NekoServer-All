    "samba_user": "auto",
    "samba_media_write": false,
    "shares": {
      "Media": "library",
      "Photos": "photos/archive"
    },
    "share_mode": "lan"
  },
  "monitoring": {
    "interval_minutes": 60,
    "report_dir": "/srv/nekoserver/reports/media",
    "enabled": false
  },
  "onboarding": {
    "enabled": true,
    "wait_seconds": 180,
    "collect_sources": true,
    "configure_indexers": true,
    "configure_libraries": true,
    "configure_request_providers": true
  },
  "tv": {
    "user": "auto",
    "desktop_shortcuts": true,
    "bluetooth": true,
    "keep_awake": true
  },
  "dashboard": {
    "port": 8787,
    "interval_seconds": 60,
    "smart_interval_seconds": 1800,
    "install_smartmontools": true,
    "fan_control": true,
    "rgb": true
  },
  "gateway": {
    "services": [
      "jellyfin",
      "seerr",
      "immich",
      "navidrome",
      "nextcloud"
    ],
    "lan_ip": "auto",
    "lan_cidr": "auto",
    "confirmed_services": []
  },
  "runtime": {
    "backend": "rust"
  },
  "app_backup": {
    "time": "04:15",
    "keep_snapshots": 7
  },
  "notifications": {
    "endpoint": "",
    "debounce_seconds": 180,
    "repeat_seconds": 43200,
    "minimum_interval_seconds": 300
  },
  "server_os": {
    "hdd_policy": "idle",
    "journal_disk_mb": 512,
    "journal_ram_mb": 64,
    "journal_retention_days": 14,
    "hdd_idle_minutes": 60
  },
  "host_backup": {
    "time": "05:15",
    "user": "auto",
    "steam": true,
    "samba": true,
    "extra_paths": [],
    "minimum_free_gb": 2,
    "keep_snapshots": 7
  },
  "heartbeat": {
    "interval_seconds": 300
  },
  "nextcloud": {
    "enabled": true,
    "image": "auto",
    "trusted_hosts": [
      "localhost",
      "127.0.0.1"
    ],
    "public_url": "",
    "admin_user": "admin"
  },
  "maintenance": {
    "time": "02:30",
    "minimum_free_gb": 20,
    "keep_snapshots": 3,
    "night_end_hour": 6,
    "health_wait_seconds": 300,
    "immich_major_update": "",
    "nextcloud_major_update": ""
  },
  "music": {
    "create_desktop_shortcut": true,
    "backup_time": "03:45",
    "backup_enabled": false
  },
  "accounts": {
    "enabled": true,
    "wait_seconds": 180
  },
  "guided_setup": {
    "enabled": true
  }
