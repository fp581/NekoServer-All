[Unit]
Description=NekoServer retry an unfinished monthly update
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
After=docker.service
Requires=docker.service
ConditionPathExists=/etc/nekoserver-backups/maintenance-resume.json
[Service]
Type=oneshot
UMask=0077
Environment=NEKOSERVER_MAINTENANCE_RETRY=1
TimeoutStartSec=infinity
ExecStart=/srv/nekoserver/installer/runtime/v0.49.0/nekoserver-runtime maintenance-resume --config /etc/nekoserver-backups/maintenance.json
