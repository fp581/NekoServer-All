[Unit]
Description=NekoServer media application snapshot
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
After=docker.service nekoserver-app-resume.service nekoserver-maintenance-resume.service
[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=6h
ExecStart=/srv/nekoserver/installer/runtime/v0.49.0/nekoserver-runtime app-snapshot --config /etc/nekoserver-backups/applications.json
ExecStopPost=/srv/nekoserver/installer/runtime/v0.49.0/nekoserver-runtime app-resume --config /etc/nekoserver-backups/applications.json
TimeoutStopSec=3h30min
