[Unit]
Description=NekoServer add-only USB backup of photos and Nextcloud files
RequiresMountsFor=/mnt/nekoserver-media
After=nekoserver-immich-db-backup.service
[Service]
Type=oneshot
ExecStart=/srv/nekoserver/installer/runtime/v0.50.0/nekoserver-runtime weekly --config /etc/nekoserver-backups/storage.json --uuid nfs-fd036bf457edf5399e8cfd9ada6ca50b --fstype nfs4 --source /mnt/nekoserver-media/photos/archive --dest /mnt/nekoserver-photos --media-root /mnt/nekoserver-media --data /srv/nekoserver --cloud /mnt/nekoserver-media/cloud/files
ExecStopPost=/srv/nekoserver/installer/runtime/v0.50.0/nekoserver-runtime cloud-resume --config /etc/nekoserver-backups/storage.json
TimeoutStopSec=3h30min
