[Unit]
Description=NekoServer independent availability heartbeat
After=network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
RuntimeDirectory=nekoserver-heartbeat
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/lib/nekoserver-heartbeat/v0.48.2/nekoserver-runtime heartbeat --config /etc/nekoserver-heartbeat/config.json
TimeoutStartSec=40
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
