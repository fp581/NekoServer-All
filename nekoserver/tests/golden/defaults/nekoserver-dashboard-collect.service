[Unit]
Description=NekoServer dashboard collection
[Service]
Type=oneshot
RuntimeDirectory=nekoserver-dashboard
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/lib/nekoserver-dashboard/v0.49.0/nekoserver-runtime collect --config /etc/nekoserver-dashboard/config.json --output /run/nekoserver-dashboard/status.json --state /srv/nekoserver/dashboard-state
TimeoutStartSec=180
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/run/nekoserver-dashboard -/srv/nekoserver/dashboard-state
RestrictAddressFamilies=AF_UNIX
