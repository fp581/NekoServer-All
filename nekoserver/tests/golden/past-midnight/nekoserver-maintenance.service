[Unit]
Description=NekoServer monthly check of every backup copy, snapshot and restore test
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
UMask=0077
Environment=TZ=Asia/Jerusalem
TimeoutStartSec=18h
TimeoutStopSec=infinity
ExecStart=/srv/nekoserver/installer/runtime/v0.50.0/nekoserver-runtime maintenance --config /etc/nekoserver-backups/maintenance.json
ExecStopPost=/srv/nekoserver/installer/runtime/v0.50.0/nekoserver-runtime maintenance-resume --config /etc/nekoserver-backups/maintenance.json
