[Unit]
Description=NekoServer update %i now
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
UMask=0077
Environment=TZ=Asia/Jerusalem
TimeoutStartSec=6h
TimeoutStopSec=infinity
ExecStart=/srv/nekoserver/installer/runtime/v0.50.0/nekoserver-runtime update-apps --config /etc/nekoserver-backups/maintenance.json --app %i
ExecStopPost=/srv/nekoserver/installer/runtime/v0.50.0/nekoserver-runtime maintenance-resume --config /etc/nekoserver-backups/maintenance.json
