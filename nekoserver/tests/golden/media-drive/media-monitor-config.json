    "backend": "rust"
  },
  "backup_times": {
    "daily": "04:15",
    "weekly_day": "Sun",
    "weekly": "03:00",
    "monthly": "02:30"
  },
  "app_backup": {
    "keep_snapshots": 0,
    "keep_snapshots_earlier": true
  },
  "notifications": {
    "endpoint": "",
    "debounce_seconds": 180,
    "repeat_seconds": 43200,
    "minimum_interval_seconds": 300
  },
  "server_os": {
    "hdd_policy": "keep_spinning",
    "journal_disk_mb": 1024,
    "journal_ram_mb": 64,
    "journal_retention_days": 14,
    "hdd_idle_minutes": 120
  },
  "host_backup": {
    "user": "auto",
    "steam": false,
    "samba": true,
    "extra_paths": [
      "/srv/nekoserver/notes"
    ],
    "minimum_free_gb": 4,
    "keep_snapshots": 14,
    "keep_snapshots_earlier": true
  },
  "heartbeat": {
    "interval_seconds": 600
  },
  "nextcloud": {
    "enabled": true,
    "image": "auto",
    "trusted_hosts": [
      "localhost",
      "127.0.0.1"
    ],
    "public_url": "",
    "admin_user": "admin"
  },
  "maintenance": {
    "minimum_free_gb": 20,
    "keep_snapshots": 0,
    "night_end_hour": 6,
    "health_wait_seconds": 300,
    "settle_days": 3,
    "update_day": "Sat",
    "nekoserver_channel": "stable",
    "immich_major_update": "",
    "nextcloud_major_update": ""
  },
  "music": {
    "create_desktop_shortcut": true,
    "backup_enabled": true
  },
  "accounts": {
    "enabled": true,
    "wait_seconds": 180
  },
  "guided_setup": {
    "enabled": true
  },
  "assistant": {
    "model": "auto"
  },
  "backup_counts_reviewed": true,
