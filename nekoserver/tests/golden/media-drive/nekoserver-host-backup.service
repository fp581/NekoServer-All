[Unit]
Description=NekoServer host and user snapshot
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
After=nekoserver-host-resume.service nekoserver-maintenance-resume.service
[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=6h
ExecStart=/srv/nekoserver/installer/runtime/v0.48.2/nekoserver-runtime host-snapshot --config /etc/nekoserver-backups/host.json
ExecStopPost=/srv/nekoserver/installer/runtime/v0.48.2/nekoserver-runtime host-resume --config /etc/nekoserver-backups/host.json
TimeoutStopSec=3h30min
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
