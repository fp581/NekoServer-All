[Unit]
Description=NekoServer recover interrupted monthly maintenance
RequiresMountsFor=/srv/nekoserver /mnt/nekoserver-media
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=infinity
ExecStart=/srv/nekoserver/installer/runtime/v0.48.1/nekoserver-runtime maintenance-resume --config /etc/nekoserver-backups/maintenance.json
[Install]
WantedBy=multi-user.target
