[Unit]
Description=NekoServer change your media folders (from the dashboard)
RequiresMountsFor=/srv/nekoserver
After=docker.service
[Service]
Type=oneshot
UMask=0077
TimeoutStartSec=infinity
ExecStart=/usr/bin/python3 -Es /srv/nekoserver/installer/releases/v0.51.3/media_locations.py run --config /srv/nekoserver/installer/releases/v0.51.3/config.json --request /run/nekoserver-control/media-folders/request.json --also "/home/amy/NekoServer All/nekoserver/my-config.json"
