      "groups": ["photos"],
      "tailnet": 8445
    },
    {
      "id": "seerr",
      "name": "Seerr",
      "role": "Find something to watch",
      "port": 5055,
      "media": true,
      "groups": ["movies"],
      "tailnet": 8444
    },
    {
      "id": "navidrome",
      "name": "Navidrome",
      "role": "Your music, everywhere",
      "port": 4533,
      "media": true,
      "groups": ["music"],
      "tailnet": 8446
    },
    {
      "id": "sonarr",
