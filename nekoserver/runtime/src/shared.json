{
  "_about": "Facts both halves of NekoServer use: the runtime builds this file in (common::SHARED), setup reads it (neko_common.SHARED). One copy, so the two can never disagree.",
  "locations": {
    "photos": {
      "default": "ssd",
      "folders": ["photos/immich-library"]
    },
    "music": {
      "default": "ssd",
      "folders": ["library/music", "library/downloads/music"]
    },
    "cloud": {
      "default": "media",
      "folders": ["cloud/files"]
    },
    "movies": {
      "default": "media",
      "folders": [
        "library/movies",
        "library/tv",
        "library/downloads"
      ]
    }
  },
  "nas_watch": {
    "state": "/run/nekoserver-nas-watch.json",
    "lock": "/run/nekoserver-nas-watch.lock",
    "probe_dir": ".nekoserver-check",
    "service": "nekoserver-nas-watch.service",
    "timer": "nekoserver-nas-watch.timer"
  },
  "compose": {
    "_about": "What a Compose file may hold, as `docker compose config --format json` shows it. Anything else (use_api_socket, post_start/pre_stop hooks, secrets, configs, cap_add, a new key Docker adds later) is refused until NekoServer knows what it gives the app. Checked by maintenance.rs valid_model, for setup (check-compose) and the monthly update.",
    "security_opt": ["no-new-privileges:true", "no-new-privileges"],
    "file_keys": ["name", "services", "volumes", "networks"],
    "service_keys": [
      "image",
      "container_name",
      "command",
      "entrypoint",
      "environment",
      "healthcheck",
      "depends_on",
      "networks",
      "ports",
      "restart",
      "volumes",
      "security_opt",
      "devices",
      "user",
      "init",
      "shm_size",
      "labels",
      "hostname",
      "stop_grace_period",
      "stop_signal",
      "working_dir",
      "expose",
      "tmpfs",
      "ulimits",
      "pull_policy"
    ]
  },
  "writers": ["docker.socket", "docker.service", "smbd.service", "smb.service", "nekoserver-gateway-lan.service"],
  "setup_lock": "/run/nekoserver-setup.lock",
  "release_tag": "v?([0-9]{1,6})\\.([0-9]{1,6})\\.([0-9]{1,6})(-?[Bb]eta)?",
  "immich_targets": {
    "_about": "Where Immich's containers see the photo library (older and newer image) and the database. Checked by the snapshot's Compose rules (maintenance.rs immich_binds_ok) and by the acceptance check of the running containers (acceptance.py containers).",
    "immich-server": ["/data", "/usr/src/app/upload"],
    "database": ["/var/lib/postgresql/data"]
  },
  "recovery": {
    "maintenance": {
      "journal": "/etc/nekoserver-backups/maintenance-resume.json",
      "service": "nekoserver-maintenance-resume.service"
    },
    "app": {
      "journal": "/etc/nekoserver-backups/app-resume.json",
      "service": "nekoserver-app-resume.service"
    },
    "host": {
      "journal": "/etc/nekoserver-backups/host-resume.json",
      "service": "nekoserver-host-resume.service"
    },
    "immich": {
      "journal": "/etc/nekoserver-backups/immich-resume.json",
      "service": "nekoserver-immich-resume.service"
    },
    "nextcloud": {
      "journal": "/etc/nekoserver-backups/nextcloud-resume.json",
      "service": "nekoserver-nextcloud-resume.service"
    },
    "upgrade": {
      "journal": "/etc/nekoserver-backups/upgrade.json",
      "service": "nekoserver-upgrade-resume.service"
    },
    "immich_snapshot": {
      "journal": "/etc/nekoserver-backups/immich-snapshot-resume.json",
      "service": "nekoserver-immich-snapshot-resume.service"
    }
  },
  "apps": [
    {
      "id": "jellyfin",
